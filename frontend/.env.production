# API de produção (Render, ver requirements-api.txt). Usado por `npm run build`
# (modo "production" por padrão) -- tem prioridade sobre .env.local, então builds
# de produção sempre apontam pra cá mesmo com .env.local configurado pro uvicorn
# local. Não é segredo: essa URL fica embutida no dist/index.html público de
# qualquer forma.
VITE_API_BASE_URL=https://alymarket-api.onrender.com
