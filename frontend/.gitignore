node_modules
# `dist/index.html` é o build singlefile autocontido (JS/CSS/assets inline via
# vite-plugin-singlefile) que o Streamlit Cloud embute (ver
# src/dashboard/react_embed.py) -- ele PRECISA estar commitado, já que o
# Streamlit Cloud não roda `npm run build`. Gerar e commitar a cada release do
# frontend (passo manual).
dist/*
!dist/index.html
dist-ssr
