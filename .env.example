# Copie este arquivo para .env e ajuste os valores. Nunca commitar o .env real.

# --- Diretórios de dados (gitignored) ---
DATA_RAW_DIR=./data/raw
DATA_STAGING_DIR=./data/staging
DATA_WAREHOUSE_DIR=./data/warehouse
DUCKDB_PATH=./data/warehouse/alymarket.duckdb

# --- HTTP / rate limit / identificação (conectores e enriquecimento) ---
HTTP_USER_AGENT=alymarket-bot/0.1 (contato: seu-email@dominio.com)
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=5
ENRICHMENT_CACHE_TTL_SECONDS=604800

# --- Chaves de API opcionais (enriquecimento sob demanda) ---
# BrasilAPI não exige chave.
CNPJA_API_KEY=
RECEITAWS_API_KEY=
# API Sirene/INSEE (open data) usa OAuth2 client credentials em alguns endpoints.
INSEE_CLIENT_ID=
INSEE_CLIENT_SECRET=

# --- Compliance ---
SUPPRESSION_LIST_PATH=./data/warehouse/suppression_list.csv
RETENTION_TTL_DAYS=180
AUDIT_LOG_PATH=./data/warehouse/audit_log.parquet

# --- Dashboard ---
STREAMLIT_SERVER_PORT=8501

# --- Geral ---
LOG_LEVEL=INFO
