# Copie este arquivo para .env e ajuste os valores. Nunca commitar o .env real.

# --- Diretórios de dados (gitignored) ---
DATA_RAW_DIR=./data/raw
DATA_STAGING_DIR=./data/staging
DATA_WAREHOUSE_DIR=./data/warehouse
DUCKDB_PATH=./data/warehouse/alymarket.duckdb

# --- HTTP / rate limit / identificação (conectores e enriquecimento) ---
HTTP_USER_AGENT=alymarket-bot/0.1 (contato: seu-email@dominio.com)
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=5
ENRICHMENT_CACHE_TTL_SECONDS=604800

# --- Chaves de API opcionais (enriquecimento sob demanda) ---
# BrasilAPI não exige chave.
CNPJA_API_KEY=
RECEITAWS_API_KEY=
# cnpj.biz (busca de empresas por CNPJ, POST /api/v2/empresas/cnpj) -- exige conta
# paga; usado como fonte alternativa enquanto downloader.py (Receita Federal) aponta
# pra uma URL desativada.
CNPJ_BIZ_API_TOKEN=
# API Sirene/INSEE exige autenticação (confirmado: 401 sem Authorization). Duas
# formas suportadas por src/ingestion/fr_sirene/api_client.py — preencha uma:
# 1) token já obtido (mais simples, direto):
INSEE_SIRENE_API_TOKEN=
# 2) client_credentials OAuth2 clássico (ver docstring de api_client.py sobre a
#    incerteza atual desse fluxo -- confirme contra a documentação vigente do INSEE):
INSEE_CLIENT_ID=
INSEE_CLIENT_SECRET=

# --- Compliance ---
SUPPRESSION_LIST_PATH=./data/warehouse/suppression_list.csv
RETENTION_TTL_DAYS=180
AUDIT_LOG_PATH=./data/warehouse/audit_log.parquet

# --- Scheduler (src/scheduler/scheduler.py) ---
# Tabelas de referência da Receita Federal (município, natureza jurídica) --
# baixadas/preparadas separadamente (raramente mudam; não fazem parte do ciclo
# mensal dos arquivos de stock que o scheduler BR atualiza a cada rodada).
BR_MUNICIPIO_LOOKUP_CSV=
BR_NATUREZA_JURIDICA_LOOKUP_CSV=
# Estado de idempotência (última competência processada com sucesso por fonte) --
# lido também pelo dashboard (painel "última rodada por fonte").
SCHEDULER_STATE_PATH=./data/warehouse/scheduler_state.json

# --- Dashboard ---
STREAMLIT_SERVER_PORT=8501
EXPORTS_DIR=./data/exports

# --- Geral ---
LOG_LEVEL=INFO
